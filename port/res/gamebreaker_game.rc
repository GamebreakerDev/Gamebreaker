/* Resources of the game program (gamebreaker.exe): its icon and version
   information. Added to the build by port\CMakeLists.txt. The icon is original
   artwork (launcher\prototype\make-icon.ps1 -Game); nothing here comes from the
   game. The icon's path is relative to this file. */
#include <winver.h>

/* port\CMakeLists.txt writes the release version into gb_version_rc.h in the
   build folder; these are the fallbacks. */
#include "gb_version_rc.h"
#ifndef GB_VERSION_STR
#define GB_VERSION_STR "0.1.0"
#endif
#ifndef GB_VER_NUM
#define GB_VER_NUM 0,1,0,0
#endif

1 ICON "gamebreaker_game.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GB_VER_NUM
PRODUCTVERSION GB_VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Gamebreaker"
            VALUE "FileVersion", GB_VERSION_STR
            VALUE "InternalName", "gamebreaker"
            VALUE "OriginalFilename", "gamebreaker.exe"
            VALUE "ProductName", "Gamebreaker"
            VALUE "ProductVersion", GB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
