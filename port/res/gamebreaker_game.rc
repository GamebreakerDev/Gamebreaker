/* Resources of the game program (gamebreaker.exe): its icon and version
   information. Added to the build by port\CMakeLists.txt. The icon is original
   artwork (launcher\prototype\make-icon.ps1 -Game); nothing here comes from the
   game. The icon's path is relative to this file. */
#include <winver.h>

1 ICON "gamebreaker_game.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Gamebreaker"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "gamebreaker"
            VALUE "OriginalFilename", "gamebreaker.exe"
            VALUE "ProductName", "Gamebreaker"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
