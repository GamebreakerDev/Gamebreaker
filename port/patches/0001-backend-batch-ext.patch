+#if VSH_SIMD
+typedef struct { __m128 c[4]; } vq;          /* component k of four vertices */
+
+static inline __m128 q_sel(__m128 m, __m128 a, __m128 b)
+{
+    return _mm_or_ps(_mm_and_ps(m, a), _mm_andnot_ps(m, b));
+}
+
+static inline void q_read(const DecSrc *d, const vq *inq, const vq *regs,
+                          const int a0[4], vq *r)
+{
+    int k;
