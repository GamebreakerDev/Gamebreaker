+    if (d->mux == DEC_TEMP || d->mux == DEC_INPUT) {
+        const vq *s = d->mux == DEC_TEMP ? &regs[d->idx] : &inq[d->idx];
+        for (k = 0; k < 4; k++)
+            r->c[k] = s->c[d->sw[k]];
+    } else if (d->cptr) {
+        for (k = 0; k < 4; k++)
+            r->c[k] = _mm_set1_ps(d->cptr[d->sw[k]]);
+    } else {
+        const float *row[4];
+        int l;
+        for (l = 0; l < 4; l++) {
