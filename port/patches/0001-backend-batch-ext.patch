+/* Four (x, y, z, w) rows of four vertices to four component vectors, and back. */
+static inline void q_from_rows(vq *q, const float *r0, const float *r1,
+                               const float *r2, const float *r3)
+{
+    __m128 a = _mm_loadu_ps(r0), b = _mm_loadu_ps(r1);
+    __m128 c = _mm_loadu_ps(r2), d = _mm_loadu_ps(r3);
+    _MM_TRANSPOSE4_PS(a, b, c, d);
+    q->c[0] = a; q->c[1] = b; q->c[2] = c; q->c[3] = d;
+}
+
+static inline void q_to_rows(const vq *q, float *r0, float *r1, float *r2, float *r3)
+{
+    __m128 a = q->c[0], b = q->c[1], c = q->c[2], d = q->c[3];
+    _MM_TRANSPOSE4_PS(a, b, c, d);
+    _mm_storeu_ps(r0, a); _mm_storeu_ps(r1, b);
+    _mm_storeu_ps(r2, c); _mm_storeu_ps(r3, d);
