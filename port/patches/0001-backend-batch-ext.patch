+/* Repeat-vertex cache (Gamebreaker patch). A batch names many vertices more
+ * than once (strip joins, shared corners of a mesh): 41 to 46% of the indices
+ * of a match are repeats within their batch. Within one call of
+ * raster_batch_program the result of transform_vertex depends only on the
+ * index, because everything else it reads is fixed for the whole call:
+ *   - the attribute formats, offsets and strides, and the immediate values of
+ *     attributes with no array (s_gpu.attr, s_gpu.imm_attr);
+ *   - the program and the 192 constants (methods are only processed between
+ *     batches, by this thread), unless the program may write c[] back
+ *     (_CXT_WRITE_EN): then a later vertex can see other constants, and the
+ *     cache is not used for that batch;
+ *   - the interpreter's own registers, cleared for every vertex
+ *     (vsh_init_regs), so no vertex sees another's temporaries;
+ *   - the fixed-function matrix, lights and registers (ffp_vertex);
+ *   - the surface scale (aa_sx, aa_sy) and the inline payload.
+ * The vertex data in guest memory can be rewritten by the game while a batch
+ * is transformed; taking the first result for a repeat is the same as reading
+ * both at that moment, which is what the hardware's own post-transform cache
+ * does. So a repeat takes a copy of the first transform of that index in the
+ * same batch. The tag is the batch's serial number and the index, so an entry
+ * from any earlier batch never matches; a slot is a direct-mapped entry by
+ * the index's low bits, and two indices that share it only cost a transform.
+ * RECOMP_XF_CACHE=0 turns it off; RECOMP_XF_CACHE=check transforms every
+ * repeat again and compares the bytes with the copy it would have used. */
+#define XF_CACHE_SIZE 4096u                   /* a power of two */
+static struct { uint32_t batch, index, slot; } s_xfc[XF_CACHE_SIZE];
+static uint32_t s_xfc_batch;
+static int s_xfc_mode = -1;                   /* 0 off, 1 on, 2 on and checked */
+static uint64_t s_xfc_idx, s_xfc_hits, s_xfc_checked, s_xfc_diff;
+
+static int xf_cache_mode(void)
+{
+    if (s_xfc_mode < 0) {
+        const char *e = getenv("RECOMP_XF_CACHE");
+        s_xfc_mode = !e ? 1 : e[0] == '0' ? 0 : strcmp(e, "check") == 0 ? 2 : 1;
+        fprintf(stderr, "[XF-CACHE] repeat-vertex cache %s\n",
+                s_xfc_mode == 0 ? "off" : s_xfc_mode == 2 ? "on, every repeat checked" : "on");
+    }
+    return s_xfc_mode;
+}
