+static void q_ilu(uint32_t op, const vq *c, vq *r)
+{
+    const __m128 one = _mm_set1_ps(1.0f), zero = _mm_setzero_ps();
+    const __m128 absm = _mm_castsi128_ps(_mm_set1_epi32(0x7FFFFFFF));
+    __m128 x = c->c[0];
+
+    switch (op) {
+    case 1:                                                      /* mov */
+        *r = *c;
+        break;
+    case 2:                                                      /* rcp */
+        q_splat(r, q_sel(_mm_cmpeq_ps(x, zero), _mm_set1_ps(INFINITY),
+                         _mm_div_ps(one, x)));
+        break;
+    case 3: {                                                    /* rcc */
+        __m128 f = _mm_div_ps(one, x), neg;
+        neg = _mm_cmplt_ps(f, zero);
+        f = q_sel(_mm_cmplt_ps(_mm_and_ps(f, absm), _mm_set1_ps(5.42101e-20f)),
