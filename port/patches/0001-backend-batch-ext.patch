+ * slots four at a time (nv2a_vsh_run4); then each repeat takes its copy. A
+ * transform depends only on its index within the call (see above), so the
+ * order of the passes changes no result. */
+static uint32_t *s_xf_todo;                   /* slots to transform, in order */
+static uint32_t (*s_xf_rep)[2];               /* repeat slot, slot of its first */
