+    switch (op) {
+    case 2:
+        for (k = 0; k < 4; k++) r->c[k] = _mm_mul_ps(a->c[k], b->c[k]);
+        break;
+    case 3:
+        for (k = 0; k < 4; k++) r->c[k] = _mm_add_ps(a->c[k], c->c[k]);
+        break;
+    case 4:
+        for (k = 0; k < 4; k++)
+            r->c[k] = _mm_add_ps(_mm_mul_ps(a->c[k], b->c[k]), c->c[k]);
+        break;
+    case 5: case 6: case 7: {
+        __m128 t = _mm_add_ps(_mm_add_ps(_mm_mul_ps(a->c[0], b->c[0]),
+                                         _mm_mul_ps(a->c[1], b->c[1])),
+                              _mm_mul_ps(a->c[2], b->c[2]));
+        if (op == 6)
+            t = _mm_add_ps(t, b->c[3]);                          /* dph */
+        else if (op == 7)
+            t = _mm_add_ps(t, _mm_mul_ps(a->c[3], b->c[3]));     /* dp4 */
