+                if ((s_dec[i].reads >> k & 1) && s_dec[i].src[k].mux == DEC_INPUT)
+                    used |= 1u << s_dec[i].src[k].idx;
+        s_q_used = used;
+        s_q_used_rev = s_dec_rev;
+        s_q_used_valid = 1;
+    }
+    return s_q_used;
+}
+
+static int vsh_run4_simd(const float (*const in[4])[4], Nv2aVshOutput *const out[4])
+{
+    vq inq[NV2A_VSH_INPUTS];
+    vq regs[13];                                  /* R0..R11, then oPos */
+    vq outq[13];
+    int a0[4] = {0, 0, 0, 0};
+    uint32_t i;
+    int k, l;
+
+    if (s_dec_count == 0 || !s_dec[s_dec_count - 1].final)
+        return 0;                                 /* no FINAL: as vsh_run_decoded */
+    q_used_inputs();
+    for (k = 0; k < NV2A_VSH_INPUTS; k++)
+        if (s_q_used >> k & 1)
+            q_from_rows(&inq[k], in[0][k], in[1][k], in[2][k], in[3][k]);
+
+    memset(regs, 0, sizeof regs);
+    memset(outq, 0, sizeof outq);
+    {
+        const __m128 one = _mm_set1_ps(1.0f);
+        outq[3].c[3] = outq[4].c[3] = one;        /* colours default opaque */
+        outq[9].c[3] = outq[10].c[3] = outq[11].c[3] = outq[12].c[3] = one;
+    }
+
+    for (i = 0; i < s_dec_count; i++) {
+        const DecIns *d = &s_dec[i];
+        vq a, b, c, mres, ires;
+
+        memset(&a, 0, sizeof a);
+        b = a; c = a; mres = a; ires = a;
+        if (d->reads & 1) q_read(&d->src[0], inq, regs, a0, &a);
+        if (d->reads & 2) q_read(&d->src[1], inq, regs, a0, &b);
+        if (d->reads & 4) q_read(&d->src[2], inq, regs, a0, &c);
+        if (d->mac)
+            q_mac(d->mac, &a, &b, &c, &mres, a0);
+        if (d->ilu)
+            q_ilu(d->ilu, &c, &ires);
+        if (d->mac_mask && d->mac_dst != DEC_NO_DST)
+            q_write(&regs[d->mac_dst], &mres, d->mac_mask);
+        if (d->ilu_mask && d->ilu_dst != DEC_NO_DST)
+            q_write(&regs[d->ilu_dst], &ires, d->ilu_mask);
+        if (d->omask && d->to_o) {                /* c[] writes never get here */
+            const vq *src = d->from_ilu ? &ires : &mres;
+            if (d->oaddr == 0)
+                q_write(&regs[12], src, d->omask);
+            else if (d->oaddr < 13)
+                q_write(&outq[d->oaddr], src, d->omask);
+        }
+    }
+
+    q_clamp01(&outq[3]);
+    q_clamp01(&outq[4]);
+    q_to_rows(&regs[12], out[0]->pos, out[1]->pos, out[2]->pos, out[3]->pos);
+    q_to_rows(&outq[3], out[0]->d0, out[1]->d0, out[2]->d0, out[3]->d0);
+    q_to_rows(&outq[4], out[0]->d1, out[1]->d1, out[2]->d1, out[3]->d1);
+    q_to_rows(&outq[5], out[0]->fog, out[1]->fog, out[2]->fog, out[3]->fog);
+    for (l = 0; l < 4; l++)
+        q_to_rows(&outq[9 + l], out[0]->tex[l], out[1]->tex[l],
+                  out[2]->tex[l], out[3]->tex[l]);
+    return 1;
+}
+#endif /* VSH_SIMD */
+
+int nv2a_vsh_run4(const float in[][NV2A_VSH_INPUTS][4], uint32_t n,
+                  Nv2aVshOutput *out)
+{
+    uint32_t v;
+#if VSH_SIMD
+    const float (*lin[4])[4];
+    Nv2aVshOutput spare[4], *lout[4];
+    int r;
+
+    if (n > 4)
+        return 0;
+    if (n && nv2a_vsh_simd_mode() != 0 && !s_cxt_write) {
+        if (!s_dec_valid || s_dec_rev != s_program_revision)
+            dec_program();
+        for (v = 0; v < 4; v++) {
+            lin[v] = in[v < n ? v : 0];           /* a short group repeats vertex 0 */
+            lout[v] = v < n ? &out[v] : &spare[v];
+        }
+        r = vsh_run4_simd(lin, lout);
+        if (s_simd_mode == 2) {
+            for (v = 0; v < n; v++) {
+                Nv2aVshOutput ref;
+                int r1 = vsh_run_decoded(in[v], &ref);
+                int c = r1 != r ? 2 : r1 ? out_compare(&ref, &out[v]) : 0;
+                s_simd_checked++;
+                if (r1) {
+                    const float *f = (const float *)&ref;
+                    size_t q;
+                    for (q = 0; q < sizeof ref / sizeof(float); q++)
+                        if (isnan(f[q])) {
+                            s_simd_nanout++;              /* a NaN reached an output */
+                            break;
+                        }
+                }
+                if (c == 1)
+                    s_simd_nan++;
+                if (c) {
+                    if (c == 2 && s_simd_diff++ < 16)
+                        fprintf(stderr, "[VSH-SIMD] vertex differs (one at a time %d,"
+                                " four %d): pos %.9g %.9g %.9g %.9g vs %.9g %.9g %.9g %.9g\n",
+                                r1, r, ref.pos[0], ref.pos[1], ref.pos[2], ref.pos[3],
+                                out[v].pos[0], out[v].pos[1], out[v].pos[2], out[v].pos[3]);
+                    out[v] = ref;
+                    r = r1;
+                }
+            }
+        }
+        return r;
+    }
+#endif
+    for (v = 0; v < n; v++)
+        if (!nv2a_vsh_run(in[v], &out[v]))
+            return 0;
+    return 1;
+}
