+        break;
+    }
+    case 8:                                                      /* dst */
+        r->c[0] = one;
+        r->c[1] = _mm_mul_ps(a->c[1], b->c[1]);
+        r->c[2] = a->c[2];
+        r->c[3] = b->c[3];
+        break;
+    case 9:                                                      /* min */
+        for (k = 0; k < 4; k++)
+            r->c[k] = q_sel(_mm_cmplt_ps(a->c[k], b->c[k]), a->c[k], b->c[k]);
+        break;
+    case 10:                                                     /* max */
+        for (k = 0; k < 4; k++)
+            r->c[k] = q_sel(_mm_cmpge_ps(a->c[k], b->c[k]), a->c[k], b->c[k]);
+        break;
+    case 11:                                                     /* slt */
+        for (k = 0; k < 4; k++)
+            r->c[k] = _mm_and_ps(_mm_cmplt_ps(a->c[k], b->c[k]), one);
+        break;
+    case 12:                                                     /* sge */
+        for (k = 0; k < 4; k++)
