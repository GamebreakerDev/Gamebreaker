+/* ---- four vertices at once (Gamebreaker patch) ---------------------------- *
+ *
+ * vsh_run_decoded pays the op switch and the source plumbing once per
+ * instruction per vertex. nv2a_vsh_run4 runs the same decoded program on four
+ * vertices together: every register is held as four SSE2 vectors, one per
+ * component, each holding that component of the four vertices ("structure of
+ * arrays"). A swizzle is then only a choice of which vector to take, and each
+ * arithmetic step is one instruction for all four.
+ *
+ * The results are bit for bit those of vsh_run_decoded, because every step
+ * is the same IEEE single-precision operation in the same order:
+ *  - add, multiply, divide and square root are the scalar SSE operations
+ *    applied lane by lane (addps/mulps/divps/sqrtps round exactly as
+ *    addss/mulss/divss/sqrtss); no fused multiply-add, and never the
+ *    approximate rcpps/rsqrtps;
+ *  - the dot products add their products in the scalar code's order,
+ *    ((x + y) + z) + w;
+ *  - MIN, MAX, SLT and SGE are compare-and-select with the scalar code's
+ *    exact conditions (a < b, a >= b), so NaNs and signed zeros pick the same
+ *    operand; RCP, RCC and RSQ keep their special cases (RCP of -0 is +inf);
+ *  - ARL rounds each lane with the scalar floorf, so every vertex keeps its
+ *    own a0 and an a0-relative constant read fetches each lane's own row;
+ *  - EXP, LOG and LIT (rare) run the scalar run_ilu on each lane.
+ * A program that may write c[] (_CXT_WRITE_EN) would let one vertex see the
+ * constants another wrote; it runs one vertex at a time, in order, as before.
+ *
+ * RECOMP_VSH_SIMD=0 transforms one vertex at a time as before;
+ * RECOMP_VSH_SIMD=check runs both on every vertex and counts the vertices
+ * whose outputs differ (they then take the one-at-a-time result); a vertex
+ * that differs only in the bits of a NaN is counted apart (out_compare).
+ * RECOMP_VSH_DUMP, RECOMP_VSH_DECODED=0 and RECOMP_VSH_CHECK=1 keep the
+ * one-at-a-time path they were written for. */
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+#define VSH_SIMD 1
+#include <emmintrin.h>
+#else
+#define VSH_SIMD 0
+#endif
+
+static int s_simd_mode = -1;                 /* 0 off, 1 on, 2 on and checked */
+static unsigned long long s_simd_checked, s_simd_diff, s_simd_nan, s_simd_nanout;
+
+int nv2a_vsh_simd_mode(void)
+{
+    if (s_simd_mode < 0) {
+        const char *e = getenv("RECOMP_VSH_SIMD");
+        const char *d = getenv("RECOMP_VSH_DECODED");
+        const char *c = getenv("RECOMP_VSH_CHECK");
+        s_simd_mode = !e ? 1 : e[0] == '0' ? 0 : strcmp(e, "check") == 0 ? 2 : 1;
+        if (!VSH_SIMD || getenv("RECOMP_VSH_DUMP") || (d && d[0] == '0') || (c && c[0] == '1'))
+            s_simd_mode = 0;
+        fprintf(stderr, "[VSH-SIMD] four vertices at once %s\n",
+                s_simd_mode == 0 ? "off" : s_simd_mode == 2 ? "on, every vertex checked" : "on");
+    }
+    return s_simd_mode;
+}
