+        q_splat(r, f);
+        break;
+    }
+    case 4:                                                      /* rsq */
+        q_splat(r, _mm_div_ps(one, _mm_sqrt_ps(_mm_and_ps(x, absm))));
+        break;
+    default: {                                     /* exp, log, lit: per lane */
+        float in[4][4], o[4][4];
+        int k, l;
+        for (k = 0; k < 4; k++)
+            _mm_storeu_ps(in[k], c->c[k]);
+        for (l = 0; l < 4; l++) {
+            vec4 v, w;
+            for (k = 0; k < 4; k++)
+                v.v[k] = in[k][l];
+            w = run_ilu(op, v);
+            for (k = 0; k < 4; k++)
