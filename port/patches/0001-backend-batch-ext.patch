+    if (mask & 4) dst->c[1] = src->c[1];
+    if (mask & 2) dst->c[2] = src->c[2];
+    if (mask & 1) dst->c[3] = src->c[3];
+}
+
+static inline void q_splat(vq *r, __m128 v)
+{
+    r->c[0] = r->c[1] = r->c[2] = r->c[3] = v;
+}
