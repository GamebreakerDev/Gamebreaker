+/* 0 the same, 1 different only where both hold a NaN, 2 different. When both
+ * operands of an add or multiply are NaNs, x86 returns the first one's, and a
+ * compiler may swap the operands of either code: such a vertex can differ in
+ * the sign or payload of a NaN and in nothing else, which no comparison,
+ * clamp or clip downstream can tell apart. */
+static int out_compare(const Nv2aVshOutput *a, const Nv2aVshOutput *b)
+{
+    const float *fa = (const float *)a, *fb = (const float *)b;
+    size_t f;
+    int r = 0;
+
+    for (f = 0; f < sizeof *a / sizeof(float); f++)
+        if (memcmp(&fa[f], &fb[f], sizeof(float)) != 0) {
+            if (!(isnan(fa[f]) && isnan(fb[f])))
+                return 2;
+            r = 1;
+        }
+    return r;
+}
