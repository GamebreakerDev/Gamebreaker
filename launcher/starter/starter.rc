/* Resources of Gamebreaker.exe: the launcher's icon, version information and
   a manifest (runs as the user, never asks for administrator rights). The
   version numbers come from gb_version.h, which build.ps1 writes. */
#include <winver.h>
#include "gb_version.h"

#ifndef GB_VER_NUM
#define GB_VER_NUM 0,0,0,0
#endif
#ifndef GB_VER_TEXT
#define GB_VER_TEXT "dev"
#endif

1 ICON "../prototype/gamebreaker.ico"
1 24 "starter.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GB_VER_NUM
PRODUCTVERSION GB_VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Gamebreaker launcher"
            VALUE "FileVersion", GB_VER_TEXT
            VALUE "InternalName", "Gamebreaker"
            VALUE "OriginalFilename", "Gamebreaker.exe"
            VALUE "ProductName", "Gamebreaker"
            VALUE "ProductVersion", GB_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
